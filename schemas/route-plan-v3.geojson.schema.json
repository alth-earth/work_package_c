{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arctic-route.local/schemas/route-plan-v3.geojson.schema.json",
  "title": "CD RoutePlan v3 GeoJSON",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "minItems": 3,
      "prefixItems": [{"$ref": "#/$defs/routeFeature"}],
      "items": {"$ref": "#/$defs/waypointFeature"}
    }
  },
  "$defs": {
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "routeFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "pattern": "^route-v3-sha256-[0-9a-f]{64}$"},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "LineString"},
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": -180, "maximum": 180},
                  {"type": "number", "minimum": -90, "maximum": 90}
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "properties": {"$ref": "#/$defs/routeProperties"}
      }
    },
    "routeProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "scenario_id", "corridor_id", "vessel_profile_id",
        "config_digest", "model_config_digest", "planner_config_digest", "provenance",
        "generation_id", "plan_id", "plan_version", "planning_request_id", "input_revision",
        "generated_at", "as_of_time", "start_time", "objective_mode", "plan_kind", "metrics",
        "replan_reasons", "source_risk_ids", "planner_version", "destination_reached",
        "planning_layer", "layer_set_id", "focus_start_time", "focus_end_time",
        "reference_plan_id", "layer_goal_reached", "waypoint_etas", "recommended_speeds_mps"
      ],
      "properties": {
        "schema_version": {"const": "cd.route-plan.v3"},
        "run_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "corridor_id": {"type": "string", "minLength": 1},
        "vessel_profile_id": {"type": "string", "minLength": 1},
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planner_config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {"enum": ["formal", "legacy_unverified", "synthetic"]},
        "generation_id": {"type": "integer", "minimum": 0},
        "plan_id": {"type": "string", "pattern": "^route-v3-sha256-[0-9a-f]{64}$"},
        "plan_version": {"type": "string", "minLength": 1},
        "planning_request_id": {"type": "string", "minLength": 1},
        "input_revision": {"type": "integer", "minimum": 0},
        "generated_at": {"$ref": "#/$defs/utcDateTime"},
        "as_of_time": {"$ref": "#/$defs/utcDateTime"},
        "start_time": {"$ref": "#/$defs/utcDateTime"},
        "objective_mode": {"enum": ["fastest", "low_risk", "recommended"]},
        "plan_kind": {"enum": ["initial", "replanned"]},
        "metrics": {"$ref": "route-plan-v3.schema.json#/$defs/metrics"},
        "replan_reasons": {"type": "array", "items": {"enum": ["time", "data", "risk", "deviation", "event", "manual"]}, "uniqueItems": true},
        "source_risk_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "planner_version": {"type": "string", "minLength": 1},
        "destination_reached": {"type": "boolean"},
        "planning_layer": {"enum": ["full_voyage", "main_corridor_24_72h", "rolling_0_24h", "executable_0_6h"]},
        "layer_set_id": {"type": "string", "pattern": "^layer-set-sha256-[0-9a-f]{64}$"},
        "focus_start_time": {"$ref": "#/$defs/utcDateTime"},
        "focus_end_time": {"$ref": "#/$defs/utcDateTime"},
        "reference_plan_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^route-v3-sha256-[0-9a-f]{64}$"}
          ]
        },
        "layer_goal_reached": {"type": "boolean"},
        "waypoint_etas": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/utcDateTime"}},
        "recommended_speeds_mps": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "waypointFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "minLength": 1},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Point"},
            "coordinates": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feature_role", "plan_id", "index", "eta", "recommended_speed_mps"],
          "properties": {
            "feature_role": {"const": "waypoint"},
            "plan_id": {"type": "string", "pattern": "^route-v3-sha256-[0-9a-f]{64}$"},
            "index": {"type": "integer", "minimum": 0},
            "eta": {"$ref": "#/$defs/utcDateTime"},
            "recommended_speed_mps": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  }
}
