{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arctic-route/cd/route-plan-v2.schema.json",
  "title": "CD RoutePlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "scenario_id", "corridor_id", "vessel_profile_id",
    "config_digest", "model_config_digest", "planner_config_digest", "provenance", "generation_id",
    "plan_id", "plan_version", "planning_request_id", "input_revision", "generated_at",
    "as_of_time", "start_time", "objective_mode", "plan_kind", "waypoints", "metrics",
    "replan_reasons", "source_risk_ids", "planner_version", "destination_reached"
  ],
  "properties": {
    "schema_version": {"const": "cd.route-plan.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "corridor_id": {"type": "string", "minLength": 1},
    "vessel_profile_id": {"type": "string", "minLength": 1},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "model_config_digest": {"$ref": "#/$defs/sha256"},
    "planner_config_digest": {"$ref": "#/$defs/sha256"},
    "provenance": {"enum": ["formal", "legacy_unverified", "synthetic"]},
    "generation_id": {"type": "integer", "minimum": 0},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "planning_request_id": {"type": "string", "minLength": 1},
    "input_revision": {"type": "integer", "minimum": 0},
    "generated_at": {"$ref": "#/$defs/utcDateTime"},
    "as_of_time": {"$ref": "#/$defs/utcDateTime"},
    "start_time": {"$ref": "#/$defs/utcDateTime"},
    "objective_mode": {"enum": ["fastest", "low_risk", "recommended"]},
    "plan_kind": {"enum": ["initial", "replanned"]},
    "waypoints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/waypoint"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "replan_reasons": {"type": "array", "items": {"enum": ["time", "data", "risk", "deviation", "event", "manual"]}},
    "source_risk_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "planner_version": {"type": "string", "minLength": 1},
    "destination_reached": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "waypoint": {
      "type": "object", "additionalProperties": false,
      "required": ["longitude", "latitude", "eta", "recommended_speed_mps"],
      "properties": {
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "eta": {"$ref": "#/$defs/utcDateTime"},
        "recommended_speed_mps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["distance_km", "eta_hours", "avg_risk", "max_risk", "integrated_risk_hours", "minimum_confidence", "hard_constraint_violations", "turn_count", "expanded_nodes", "compute_ms", "objective_cost"],
      "properties": {
        "distance_km": {"type": "number", "minimum": 0}, "eta_hours": {"type": "number", "minimum": 0},
        "avg_risk": {"type": "number", "minimum": 0, "maximum": 1}, "max_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "integrated_risk_hours": {"type": "number", "minimum": 0}, "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_constraint_violations": {"const": 0}, "turn_count": {"type": "integer", "minimum": 0},
        "expanded_nodes": {"type": "integer", "minimum": 0}, "compute_ms": {"type": "number", "minimum": 0},
        "objective_cost": {"type": "number", "minimum": 0}
      }
    }
  }
}
